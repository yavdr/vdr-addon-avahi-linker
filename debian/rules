#!/usr/bin/make -f

export DH_VERBOSE=1
# export PYBUILD_DISABLE=test  # we have no running VDR in the build environment, so SVDRP will always fail
export PYBUILD_NAME=vdr-addon-avahi-linker
export PYBUILD_SYSTEM=pyproject
export DEB_BUILD_OPTIONS=nocheck

%:
	dh  $@ --with=python3 --buildsystem=pybuild

override_dh_autotest:

override_dh_installsystemd:
	dh_installsystemd --name=avahi-linker
